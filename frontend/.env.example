# FastAPI origin (baked in at `next build`). Default in code is http://127.0.0.1:8000
# Production: https://api.example.com
# Empty value = same-origin /api (Next rewrite uses API_INTERNAL_URL)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Server-side rewrite target when NEXT_PUBLIC_API_BASE is empty (Docker/Caddy same-origin).
# API_INTERNAL_URL=http://api:8000
