# FastAPI origin (no trailing slash). Browser calls this host; CORS is on the API.
# Local default if unset: http://127.0.0.1:8000
# Production (Vercel): https://<your-render-api>.onrender.com
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Same-origin proxy only: leave empty and set API_INTERNAL_URL for Next rewrites.
# NEXT_PUBLIC_API_BASE=
# API_INTERNAL_URL=http://127.0.0.1:8000
