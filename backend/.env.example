# =============================================================================
# INJECT API KEYS HERE
# Copy this file to backend/.env and fill in what you have.
# The dashboard runs without optional keys (IMD CAP + Open-Meteo + local qwen2.5).
# =============================================================================

# --- LLM (OpenAI-compatible) -------------------------------------------------
# Local: Ollama on the laptop.
# Render (or any host): set these as service env, e.g. Groq (no credit card):
#   OLLAMA_BASE_URL=https://api.groq.com/openai/v1
#   OLLAMA_API_KEY=
#   OLLAMA_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TRIAGE_MODEL=qwen2.5:0.5b
OLLAMA_API_KEY=ollama

# Switchable hosted narrators (OpenAI-compatible). Keys stay on the server.
# LLM_PROVIDER=ollama | groq | gemini | github | openrouter | xai
# LLM_FALLBACK=groq,ollama
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GITHUB_TOKEN=
# GITHUB_MODEL=meta-llama/Llama-3.1-8B-Instruct
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# XAI_API_KEY=
# XAI_MODEL=grok-4.5

# --- Official IMD REST (optional) --------------------------------------------
# Public endpoints at https://api.imd.gov.in currently return 401 unless your
# IP is whitelisted: https://api.imd.gov.in/public/index.php
# After whitelist / if they issue a key, set:
# IMD_API_KEY=
# IMD_API_BASE=https://api.imd.gov.in/api/v1

# --- AIKosh (IndiaAI dataset APIs) -------------------------------------------
# https://aikosh.indiaai.gov.in  → Toolkit → Authentication and API Key Setup
# Unlocks: Kisan Call Centre RAG, farmer-query intents, agro-climatic zones
# AIKOSH_API_KEY=
# AIKOSH_API_BASE=https://aikosh.indiaai.gov.in/api

# --- data.gov.in / OGD -------------------------------------------------------
# https://data.gov.in → My Account → API Key
# Unlocks: CPCB AQI, reservoir levels, historical crop / rainfall catalogues
# DATA_GOV_IN_API_KEY=

# --- Optional satellite / enrich --------------------------------------------
# MOSDAC login (gitignored .env only). HEM HDF is order-based; without a cached
# file Kalman scenes stay Open-Meteo analysis (labelled model-analysis).
# MOSDAC_USER=
# MOSDAC_PASS=
# MOSDAC_BASE_URL=https://www.mosdac.gov.in
# WAQI_TOKEN=
# NASA Earthdata user token (preferred) from https://urs.earthdata.nasa.gov → Generate Token
# NASA_EARTHDATA_API=
# or username/password:
# NASA_EARTHDATA_USER=
# NASA_EARTHDATA_PASS=
# Copernicus CDS ERA5 GRIB (optional; Open-Meteo ERA5 archive is used without a key)
# CDS_API_KEY=
# GRAPHCAST_WEIGHTS_DIR=
# OPENWEATHER_API_KEY=
# WEATHERBIT_API_KEY=
# EUMETSAT_TOKEN=
# One national/bbox lightning URL. Placeholders: {south}{west}{north}{east}{key}
# LIGHTNING_FEED_URL=
# LIGHTNING_FEED_KEY=

# --- Advisor translation (no key) -------------------------------------------
# Inbound any language → English for the LLM; outbound English → reply language.
# Uses Google Translate (gtx) then MyMemory. Numbers / IMD / CPCB stay locked.
# TRANSLATE_ENABLED=true

# --- App --------------------------------------------------------------------
DEFAULT_LAT=22.0667
DEFAULT_LON=88.0698
DEFAULT_STATE=West Bengal
DEFAULT_DISTRICT=Purba Medinipur
DEFAULT_PLACE=Haldia
CACHE_DIR=./.cache

# Published API origin (absolute WMS links). Required behind a public host.
# PUBLIC_BASE_URL=https://api.example.com

# Browser / React Native origins. List BOTH the website and the app origin.
# They share one uvicorn process: /api (local), /v1, /web/v1, /app/v1.
# Use * for any origin (disables cookies).
# Production: HTTPS web origin + Expo/app origin, not only localhost.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:19006
# Phones on the LAN talking to this machine (dev). Do not rely on this in production.
# CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+)(:\d+)?
